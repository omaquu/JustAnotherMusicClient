{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Another Music Client",
  "version": "1.3.1",
  "identifier": "com.justanothermusicclient.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Just Another Music Client",
        "decorations": false,
        "transparent": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "mini-player",
        "url": "/mini.html",
        "width": 160,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "visible": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ],
        "recommends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugin-libav"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
